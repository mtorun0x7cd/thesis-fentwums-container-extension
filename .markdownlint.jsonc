//
// Markdown rules of this repository. Long lines are allowed, because a
// paragraph is one line. HTML is allowed for the <details> blocks of the
// translated abstracts. A heading may repeat under a different parent. Bare
// addresses are allowed, because ERRATA.md writes the addresses it discusses
// as plain text.
{
  "default": true,
  "MD013": false,
  "MD033": false,
  "MD034": false,
  "MD041": false,
  "MD024": { "siblings_only": true }
}
