<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress NETSDK1187: upstream OneWare.AvaloniaEdit locale normalization warning -->
    <NoWarn>NETSDK1187</NoWarn>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>true</SuppressAotAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- OneWare.Essentials is excluded from runtime in the plugin's csproj (the IDE provides it).
         The standalone benchmark harness needs it explicitly so the DLL is available at runtime. -->
    <PackageReference Include="OneWare.Essentials" Version="1.0.19" />
    <ProjectReference Include="../../FEntwumS.ContainerExtension/src/ContainerExtension/ContainerExtension.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="link.xml" />
  </ItemGroup>
</Project>
