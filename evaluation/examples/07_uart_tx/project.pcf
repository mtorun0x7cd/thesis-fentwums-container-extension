## uart_tx - pin constraints (GateMate eval board)

set_io clk IO_SB_A8
set_io rst IO_WA_B2
set_io start IO_WA_A2
set_io data[0] IO_WA_A0
set_io data[1] IO_WA_B0
set_io data[2] IO_WA_A1
set_io data[3] IO_WA_B1
set_io data[4] IO_WA_A3
set_io data[5] IO_WA_B5
set_io data[6] IO_WA_A8
set_io data[7] IO_WA_B8
set_io tx IO_WA_B7
set_io busy IO_WA_A7
